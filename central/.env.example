# Copie para central/.env (o arquivo .env é ignorado pelo git). Nunca commite chaves.
# Só preencha o que for usar: todos os comandos funcionam sem chaves, com dados importados por CSV/JSON.

# Claude API (geração de conteúdo com IA: reviews, textos de KDP, listagens). Sem ela, o modo template é usado.
ANTHROPIC_API_KEY=

# Amazon Product Advertising API 5.0 (exige conta de Associado aprovada com vendas qualificadas)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com.br
AMAZON_PAAPI_REGION=us-east-1

# Shopee Affiliate Open API
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Hotmart (credenciais do painel de desenvolvedor)
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=

# Mercado Livre (opcional: token OAuth para limites maiores; a busca pública funciona sem)
MERCADOLIVRE_ACCESS_TOKEN=

# Pasta de trabalho (padrão: central/workspace)
# PRECOZEN_WORKSPACE=
