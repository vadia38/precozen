// Deploy do blog Precozen como Worker com assets estáticos (Cloudflare Workers).
// Fluxo: `npm run build:blog` gera workspace/blog/dist; `npx wrangler deploy` publica.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "precozen-blog",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./workspace/blog/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
