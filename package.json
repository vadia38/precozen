{
  "name": "catalogo-luretec",
  "version": "1.0.0",
  "description": "Catálogo online Luretec 2026 (site estático) e Precozen Central: sistema de monetização com blog de afiliados, conteúdo para Amazon KDP e designs para a Amazon.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build.js",
    "dev": "node scripts/dev.js",
    "test": "node --test \"tests/**/*.test.js\" \"central/tests/**/*.test.js\"",
    "validar": "node scripts/validar-dados.js",
    "importar": "node scripts/importar-catalogo.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:catalogo": "node --test \"tests/**/*.test.js\"",
    "test:central": "node --test \"central/tests/**/*.test.js\"",
    "central": "node central/bin/precozen.js"
  },
  "license": "UNLICENSED"
}
